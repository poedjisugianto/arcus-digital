rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isAdmin() {
      let hardcoded = ['poedji.sugianto@gmail.com', 'admin@arcus.id', 'arcus.id@gmail.com', 'user@arcus.id', 'poedjisugianto@gmail.com'];
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() in hardcoded) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('role', '') in ['SUPERADMIN', 'ADMIN', 'MASTER_ADMIN', 'superadmin', 'admin'] ||
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('data', {}).get('role', '') in ['SUPERADMIN', 'ADMIN', 'MASTER_ADMIN', 'superadmin', 'admin']
        ))
      );
    }

    function isDocOwner(ownerId) {
      return isSignedIn() && ownerId is string && ownerId != '' && (
        request.auth.uid == ownerId ||
        ('email' in request.auth.token && request.auth.token.email is string && (
          request.auth.token.email == ownerId ||
          request.auth.token.email.lower() == ownerId.lower()
        ))
      );
    }

    function isEventOwner(evData) {
      return isDocOwner(evData.get('ownerId', ''))
        || isDocOwner(evData.get('settings', {}).get('organizerId', ''))
        || isDocOwner(evData.get('data', {}).get('ownerId', ''))
        || isDocOwner(evData.get('data', {}).get('settings', {}).get('organizerId', ''));
    }

    // --- 1. Profiles ---
    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- 2. Events & Sub-collections ---
    match /events/{eventId} {
      // Events are public for viewing
      allow read: if true;
      
      // Anyone signed in can start a new tournament
      allow create: if isSignedIn();
      
      // Management restricted to owners or admins, or updating registration rosters/metadata
      allow update: if isAdmin() 
        || isEventOwner(resource.data)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archers', 'officials', 'registrationCount', 'lastRegistrationAt', 'updatedAt', 'data']);
      allow delete: if isAdmin() || isEventOwner(resource.data);

      // Participant Registrations
      match /submissions/{subId} {
        allow read: if true;
        allow create, update: if true; // Registration is public
        allow delete: if isAdmin() || isEventOwner(get(/databases/$(database)/documents/events/$(eventId)).data);
      }

      // Scores
      match /scores/{scoreId} {
        allow read: if true;
        allow write: if true;
      }

      // Score Logs
      match /scoreLogs/{logId} {
        allow read: if true;
        allow write: if true;
      }

      // Sharded Data for performance
      match /shards/{shardId} {
        allow read, write: if true; 
      }
    }

    // --- 3. System Configs ---
    match /systemConfigs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // diagnostic
    match /test/connection {
      allow read: if true;
    }
  }
}
